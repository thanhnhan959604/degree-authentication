# ============================================================================
# Mẫu cấu hình môi trường. Sao chép thành .env rồi điền giá trị của bạn:
#     copy .env.example .env        (Windows)   |   cp .env.example .env   (Linux / macOS)
# File .env bị .gitignore chặn – KHÔNG commit .env, KHÔNG dán khoá thật vào file mẫu này.
# Nếu bạn đã có .env từ trước: chỉ cần bổ sung các biến thuộc nhóm "MỚI" bên dưới (đều không bắt buộc).
# ============================================================================

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-50-ky-tu

# --- PostgreSQL (dùng chung cho dịch vụ postgres và web) -------------------
POSTGRES_DB=degree_db
POSTGRES_USER=degree_user
POSTGRES_PASSWORD=doi-mat-khau
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Hyperledger Besu (docker compose tự ghi đè địa chỉ nút khi chạy trong container) -
BESU_RPC_NODE1=http://127.0.0.1:8545
BESU_RPC_NODE2=http://127.0.0.1:8546
BESU_RPC_NODE3=http://127.0.0.1:8547
BESU_CHAIN_ID=1337

# --- Smart contract CertificateRegistry (địa chỉ sau khi deploy; xem contracts/compiled/contract_info.json)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Ví của 3 phòng (địa chỉ + khoá riêng). Chỉ dùng khoá của mạng thử nghiệm, tuyệt đối không dùng ví thật.
STUDENT_AFFAIRS_ADDRESS=0x0000000000000000000000000000000000000000
STUDENT_AFFAIRS_PRIVATE_KEY=0x-khoa-rieng-phong-qlsv
ACADEMIC_AFFAIRS_ADDRESS=0x0000000000000000000000000000000000000000
ACADEMIC_AFFAIRS_PRIVATE_KEY=0x-khoa-rieng-phong-dao-tao
RECTOR_ADDRESS=0x0000000000000000000000000000000000000000
RECTOR_PRIVATE_KEY=0x-khoa-rieng-hieu-truong

# ============================ MỚI (không bắt buộc) ===========================
# Bảo vệ CCCD sinh viên. Để trống thì hệ thống tự suy ra từ DJANGO_SECRET_KEY (khi đó đổi
# DJANGO_SECRET_KEY sẽ làm mất khả năng giải mã CCCD đã lưu). Mỗi máy dùng cơ sở dữ liệu riêng nên
# không cần trùng nhau giữa các thành viên. Tạo khoá ngẫu nhiên:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
CCCD_PEPPER=
CCCD_ENCRYPTION_KEY=

# Gửi email thật (link kích hoạt tài khoản sinh viên). Để trống thì link chỉ in ra nhật ký của container web.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Địa chỉ gốc dùng trong link / mã QR gửi ra ngoài (để trống thì dùng địa chỉ máy đang chạy)
PUBLIC_BASE_URL=
